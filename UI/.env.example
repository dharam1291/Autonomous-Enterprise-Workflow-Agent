# Copy to .env and fill in as needed. start.sh loads this file automatically
# and regenerates UI/config.js from these values before serving the frontend.

# Host/port the static frontend is served on.
FE_HOST=127.0.0.1
FE_PORT=5173

# Backend origin the UI calls. Leave unset to derive it from BE_HOST/BE_PORT.
API_BASE_URL=
