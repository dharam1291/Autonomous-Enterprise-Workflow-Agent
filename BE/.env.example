# Copy to .env and fill in as needed. start.sh loads this file automatically;
# uvicorn/app_factory.py loads it too via AppSettings.from_project_root().

# Host/port the backend binds to (used by start.sh).
BE_HOST=127.0.0.1
BE_PORT=8000

# Comma-separated origins allowed to call this API (CORS).
UI_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# LLM provider credentials. Only required if a tenant/provider config
# (see BE/config/tenants/*.yaml) selects "openai" or "anthropic" — the
# deterministic provider needs neither.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Logging. LOG_DIR defaults to BE/logs if unset; app.log is rotated at 5MB.
LOG_LEVEL=INFO
LOG_DIR=

# Observability feature flags. Both default off; flip to true to enable.
# ENABLE_TRACING  -> OpenTelemetry traces (FastAPI requests + per-claim spans).
# ENABLE_METRICS  -> Prometheus metrics exposed at GET /metrics.
# Requires the extra deps: pip install -e ".[observability]"
ENABLE_TRACING=false
ENABLE_METRICS=false

# Trace export target. If set, traces go to this OTLP/HTTP endpoint
# (e.g. an OpenTelemetry Collector); otherwise they print to the console.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name attached to every span/metric resource.
OTEL_SERVICE_NAME=aewa-backend
