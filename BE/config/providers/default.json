{
  "tenant_id": "default",
  "provider_id": "default",
  "display_name": "Default Claims Provider",
  "enabled": true,
  "document_signals": [
    "claim",
    "policy number",
    "claim amount",
    "claimant"
  ],
  "minimum_signal_match": 2,
  "entity_definitions": [
    {
      "name": "claimant_name",
      "requirement": "mandatory",
      "patterns": [
        "Claimant(?: Name)?:\\s*(?P<value>[A-Za-z][A-Za-z .'-]{2,})",
        "Patient(?: Name)?:\\s*(?P<value>[A-Za-z][A-Za-z .'-]{2,})"
      ],
      "confidence_threshold": 0.8
    },
    {
      "name": "policy_number",
      "requirement": "mandatory",
      "patterns": [
        "Policy Number:\\s*(?P<value>[A-Z]{3}-\\d{6})",
        "Policy No\\.?\\s*:\\s*(?P<value>[A-Z]{3}-\\d{6})"
      ],
      "confidence_threshold": 0.85
    },
    {
      "name": "claim_amount",
      "requirement": "mandatory",
      "patterns": [
        "Claim Amount:\\s*\\$?(?P<value>[0-9][0-9,]*(?:\\.\\d{2})?)",
        "Amount Claimed:\\s*\\$?(?P<value>[0-9][0-9,]*(?:\\.\\d{2})?)"
      ],
      "confidence_threshold": 0.9
    },
    {
      "name": "claim_reason",
      "requirement": "mandatory",
      "patterns": [
        "Reason(?: for Claim)?:\\s*(?P<value>[^\\n]+)"
      ],
      "confidence_threshold": 0.75
    },
    {
      "name": "provider_name",
      "requirement": "optional",
      "patterns": [
        "Provider(?: Name)?:\\s*(?P<value>[^\\n]+)",
        "Hospital(?: Name)?:\\s*(?P<value>[^\\n]+)"
      ],
      "confidence_threshold": 0.7
    },
    {
      "name": "incident_date",
      "requirement": "optional",
      "patterns": [
        "Incident Date:\\s*(?P<value>\\d{4}-\\d{2}-\\d{2})",
        "Service Date:\\s*(?P<value>\\d{4}-\\d{2}-\\d{2})"
      ],
      "confidence_threshold": 0.7
    }
  ],
  "business_rules": [
    {
      "id": "POLICY_NUMBER_FORMAT",
      "description": "Policy number format is valid.",
      "type": "regex_match",
      "severity": "ERROR",
      "enabled": true,
      "parameters": {
        "entity": "policy_number",
        "pattern": "[A-Z]{3}-\\d{6}"
      }
    },
    {
      "id": "POLICY_COVERAGE_LIMIT",
      "description": "Claim amount is within policy coverage limit.",
      "type": "decimal_lte",
      "severity": "ERROR",
      "enabled": true,
      "parameters": {
        "entity": "claim_amount",
        "max": 50000
      }
    }
  ],
  "hitl_rules": [
    {
      "id": "HIGH_VALUE_CLAIM_REVIEW",
      "description": "Claim amount is within automatic processing threshold.",
      "type": "decimal_gt",
      "severity": "WARNING",
      "enabled": true,
      "parameters": {
        "entity": "claim_amount",
        "threshold": 10000
      }
    }
  ],
  "features": {
    "pdf_ingestion": true,
    "auto_approval": true,
    "hitl_review": true,
    "rejection_letter_generation": true
  },
  "hitl_policy": {
    "review_timeout_minutes": 30,
    "on_timeout": "escalate",
    "escalation_role": "senior_caseworker"
  }
}

